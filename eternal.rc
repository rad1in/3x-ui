#!/sbin/openrc-run

command="/usr/local/eternal/eternal"
command_background=true
pidfile="/run/eternal.pid"
description="eternal Service"
procname="eternal"
depend() {
    need net
}
start_pre(){
    cd /usr/local/eternal
}
reload() {
  ebegin "Reloading ${RC_SVCNAME}"
  kill -USR1 $(cat $pidfile)
  eend $?
}